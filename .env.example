# Copy to .env (never commit .env). Values come from the Supabase dashboard and `npx web-push generate-vapid-keys`.

# --- Public: safe in the browser ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# --- Secret: only for Supabase Edge Functions (set with `supabase secrets set`) ---
# SUPABASE_SERVICE_ROLE_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:studio@schamborski.com

# --- Face capture (optional) ---
# Serve the MediaPipe model from your own host instead of Google's, e.g. /models/face_landmarker.task
# VITE_FACE_MODEL_URL=
